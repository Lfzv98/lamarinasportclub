# Sin estas variables la app corre en MODO DEMO usando data/mockData.json.
# Juan: al definirlas, lib/server/repository.ts usa el adaptador de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Acceso staff (solo el staff edita; ver docs/BACKEND.md)
STAFF_PIN=1234
STAFF_SECRET=
STAFF_EMAILS=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo si los usuarios del CRM de PadelReserve están en otro proyecto de Supabase:
PADELRESERVE_AUTH_URL=
PADELRESERVE_AUTH_KEY=

# Asistente IA del staff (botón IA y "Registrar con IA"). Sin clave, el botón avisa que falta.
# Gratis: crea la clave en aistudio.google.com → Get API key.
GEMINI_API_KEY=
# Opcional: modelos de Gemini a probar en orden, separados por coma
GEMINI_MODELO=
# Opcional, en vez de Gemini: Claude (de pago) y su modelo
ANTHROPIC_API_KEY=
ASISTENTE_MODELO=

# Tenis (cancha dura y arcilla): apagado. Solo para clubes con tenis (Caracas), no para La Marina.
NEXT_PUBLIC_TENIS=

# Ranking FVP (sincronización diaria con la hoja oficial; ver docs/BACKEND.md)
CRON_SECRET=
FVP_SHEET_ID=
FVP_SHEET_GIDS=
